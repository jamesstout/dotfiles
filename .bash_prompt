#!/usr/bin/env bash


# @gf3’s Sexy Bash Prompt, inspired by “Extravagant Zsh Prompt”
# Shamelessly copied from https://github.com/gf3/dotfiles and 
# https://github.com/necolas/dotfiles/blob/master/bash/bash_prompt
# Screenshot: http://i.imgur.com/s0Blh.png

tput sgr 0 0

# Base styles and color palette
# Solarized colors
# https://github.com/altercation/solarized/tree/master/iterm2-colors-solarized
BOLD=$(tput bold)
RESET=$(tput sgr0)
SOLAR_YELLOW=$(tput setaf 136)
SOLAR_ORANGE=$(tput setaf 166)
SOLAR_RED=$(tput setaf 124)
# shellcheck disable=SC2034
SOLAR_MAGENTA=$(tput setaf 125)
# shellcheck disable=SC2034
SOLAR_VIOLET=$(tput setaf 61)
# shellcheck disable=SC2034
SOLAR_BLUE=$(tput setaf 33)
SOLAR_CYAN=$(tput setaf 37)
SOLAR_GREEN=$(tput setaf 64)
SOLAR_WHITE=$(tput setaf 254)

style_user="\[${RESET}${SOLAR_ORANGE}\]"
style_host="\[${RESET}${SOLAR_YELLOW}\]"
style_path="\[${RESET}${SOLAR_GREEN}\]"
style_chars="\[${RESET}${SOLAR_WHITE}\]"
style_branch="\[${SOLAR_CYAN}\]"

if [[ "$SSH_TTY" ]]; then
    # connected via ssh
    style_host="\[${BOLD}${SOLAR_RED}\]"
elif [[ "$USER" == "root" ]]; then
    # logged in as root
    style_user="\[${BOLD}${SOLAR_RED}\]"
fi

# Git status information
prompt_git() {
    local branch_name
    local status_line
    local status_output
    local xy
    local has_staged=0
    local has_stash=0
    local has_unmerged=0
    local has_unstaged=0
    local has_untracked=0
    local git_state=""

    status_output=$(git status --porcelain=v2 --branch --show-stash 2>/dev/null) || return 0
    branch_name=$(awk '/^# branch.head / { print $3; exit }' <<<"$status_output")
    if [[ -z "$branch_name" ]]; then
        return 0
    elif [[ "$branch_name" == "(detached)" ]]; then
        branch_name=$(awk '/^# branch.oid / { print substr($3, 1, 7); exit }' <<<"$status_output")
    fi

    while IFS= read -r status_line; do
        case "$status_line" in
            '1 '*|'2 '*)
                xy="${status_line#? }"
                xy="${xy%% *}"
                [[ "${xy:0:1}" != "." ]] && has_staged=1
                [[ "${xy:1:1}" != "." ]] && has_unstaged=1
                ;;
            'u '*) has_unmerged=1 ;;
            '? '*) has_untracked=1 ;;
            '# stash '*) has_stash=1 ;;
        esac
    done <<<"$status_output"

    ((has_staged)) && git_state+='+'
    ((has_unstaged || has_unmerged)) && git_state+='!'
    ((has_untracked)) && git_state+='?'
    ((has_stash)) && git_state+='$'
    [[ -n "$git_state" ]] && branch_name+="[$git_state]"
    printf ' on %s' "$branch_name"
}

# if this is interactive shell, then bind hstr to Ctrl-r (for Vi mode check doc)
if [[ $- =~ .*i.* ]]; then bind '"\C-r": "\C-a hstr -- \C-j"'; fi

# Make new shells get the history lines from all previous
# shells instead of the default "last window closed" history
HISTORY_ARCHIVE="${HISTORY_ARCHIVE:-$HOME/.bash_eternal_history}"
LAST_ARCHIVED_HISTORY_NUMBER=""

append_eternal_history() {
    local history_entry
    local history_number
    local lock_file="${HISTORY_ARCHIVE}.lock"

    history_entry="$(HISTTIMEFORMAT='' builtin history 1)" || return 0
    [[ -n "$history_entry" ]] || return 0
    history_number="${history_entry#"${history_entry%%[![:space:]]*}"}"
    history_number="${history_number%%[[:space:]]*}"
    [[ "$history_number" == "$LAST_ARCHIVED_HISTORY_NUMBER" ]] && return 0

    /usr/bin/shlock -f "$lock_file" -p "$$" >/dev/null 2>&1 || return 0
    printf '%s\n' "$history_entry" >> "$HISTORY_ARCHIVE" || {
        rm -f "$lock_file"
        return 1
    }
    LAST_ARCHIVED_HISTORY_NUMBER="$history_number"
    rm -f "$lock_file"
}

export PROMPT_COMMAND="history -a; history -n; append_eternal_history"

# Set the terminal title to the current working directory
PS1="\[\033]0;\h: \w\007\]"
#PS1="\[\033]0;\W\007\]"
# Build the prompt
PS1+="\n" # Newline
PS1+="${style_user}\u" # Username
PS1+="${style_chars}@" # @
PS1+="${style_host}\h" # Host
PS1+="${style_chars}: " # :
PS1+="${style_path}\w" # Working directory
PS1+="${style_branch}\$(prompt_git)" # Git details
PS1+="\n" # Newline
PS1+="${style_chars}\$ \[${RESET}\]" # $ (and reset color)
