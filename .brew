#!/usr/bin/env bash
# shellcheck shell=bash

run_step() {
	local header="$1"
	shift

	e_header "$header"
	if "$@"; then
		e_success "Done"
	else
		e_error "Failed: $*"
		return 1
	fi
}

main() {
	local script_dir
	script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)" || return 1

	# shellcheck disable=SC1091
	source "$script_dir/.utils" || return 1

	if ! command -v brew >/dev/null 2>&1; then
		e_error "Error: Homebrew not found."
		return 1
	fi

	if [[ ! -f "$script_dir/Brewfile" ]]; then
		e_error "Error: Brewfile not found."
		return 1
	fi

	run_step "Updating Homebrew..." brew update || return 1
	run_step "Installing and updating declared formulae..." \
		brew bundle install --verbose --file="$script_dir/Brewfile" || return 1
	run_step "Removing old Homebrew downloads and formula versions..." \
		brew cleanup --prune=all || return 1

	if [[ "${UPDATE_CASKS:-0}" == "1" ]]; then
		if [[ ! -f "$script_dir/Brewfile.casks" ]]; then
			e_error "Error: Brewfile.casks not found."
			return 1
		fi

		run_step "Installing and updating declared casks..." \
			brew bundle install --verbose --file="$script_dir/Brewfile.casks" || return 1
	else
		e_debug "Skipping cask maintenance; run UPDATE_CASKS=1 ./.brew to include it"
	fi
}

main "$@"
