#!/usr/bin/env bash

# Header logging
e_header() {
	printf "\n$(tput setaf 7)%s$(tput sgr0)\n" "$@"
}
# debug logging
e_debug() {
	printf "$(tput setaf 2)%s$(tput sgr0)\n" "$@"
}

# Success logging
e_success() {
	printf "$(tput setaf 64)✓ %s$(tput sgr0)\n" "$@"
}

# Error logging
e_error() {
	printf "$(tput setaf 1)x %s$(tput sgr0)\n" "$@"
}

# Warning logging
e_warning() {
	printf "$(tput setaf 136)! %s$(tput sgr0)\n" "$@"
}

onoe() {
	if [[ -t 2 ]]; then # check whether stderr is a tty.
		echo -ne "\033[4;31mError\033[0m: " >&2 # highlight Error with underline and red color
	else
		echo -n "Error: " >&2
	fi
	if [[ $# -eq 0 ]]; then
		/bin/cat >&2
	else
		echo "$*" >&2
	fi
}

odie() {
	onoe "$@"
	exit 1
}

check_command() {
  if ! "$@";
  then
	 odie "$* failed"
  fi
}

safe_cd() {
	cd "$@" >/dev/null || odie "Error: failed to cd to $*!"
}

# Ask for confirmation before proceeding
seek_confirmation() {
	printf "\n"
	e_warning "$@"
	read -p "Continue? (y/n) " -n 1
	printf "\n"
}

# Test whether the result of an 'ask' is a confirmation
is_confirmed() {
	if [[ "$REPLY" =~ ^[Yy]$ ]]; then
		return 0
	fi
	return 1
}

git_pull() {

	git_info=$(get_git_branch)
	e_debug "exec git pull -v origin $git_info"
	git pull -v origin "$git_info"
}

cd_and_git_pull() {

	e_debug "cd to $1"
	safe_cd "$1"

	if ! is_git_repo; then
		e_warning "Not a git repo"
	else
		git_pull
	fi
	cd - 1>/dev/null || return 255
}

logn() {
	DOTFILES_STEP="$*"
	sudo_init
	printf -- "--> %s " "$*"
}

sudo_init() {
	# We want to always prompt for sudo password at least once rather than doing
	# root stuff unexpectedly.
	sudo -k

	if ! sudo -vn &>/dev/null; then
		if [ -n "$DOTFILES_SUDOED_ONCE" ]; then
			echo "--> Re-enter your password (for sudo access; sudo has timed out):"
		else
			echo "--> Enter your password (for sudo access):"
		fi
		sudo /usr/bin/true
		DOTFILES_SUDOED_ONCE="1"
	fi
}

sudo_cleanup() {
	if [ -n "$DOTFILES_SUDOED_ONCE" ]; then
		DOTFILES_SUDO_WAIT_PID=$(ps -aef | grep [s]udo | grep [t]rue | awk '{ print $2 }')

		if [ -n "$DOTFILES_SUDO_WAIT_PID" ]; then
			e_debug "Killing sudo PID: $DOTFILES_SUDO_WAIT_PID"
			sudo kill -9 "$DOTFILES_SUDO_WAIT_PID" >/dev/null 2>&1
		fi

		sudo -k
	fi
}

function addLoginwindowText() {

	CURRENT_TEXT=$(defaults read /Library/Preferences/com.apple.loginwindow LoginwindowText 2>/dev/null)

	if [ -n "$CURRENT_TEXT" ]; then
		e_success "LoginwindowText already set to $CURRENT_TEXT"
		unset CURRENT_TEXT
		return 0
	fi

	if [ -n "$DOTFILE_NAME" ] && [ -n "$DOTFILE_EMAIL" ]; then
		# sudo_init
		sudo defaults write /Library/Preferences/com.apple.loginwindow LoginwindowText "Found this computer? Please contact $DOTFILE_NAME at $DOTFILE_EMAIL."
		[[ $? ]] && e_success "LoginwindowText set to Found this computer? Please contact $DOTFILE_NAME at $DOTFILE_EMAIL."
		sudo_cleanup
		return 0
	fi
}

doiTermIntegrationCheck() {
	local current_file
	local current_version
	local new_file
	local new_version
	local shell_name
	local temp_dir

	e_header "Checking for iTerm shell integration update..."
	command -v curl >/dev/null 2>&1 || return 1

	shell_name="$(basename "${SHELL:-bash}")"
	current_file="$SCRIPT_DIR/.iterm2_shell_integration.$shell_name"
	if [[ ! -f "$current_file" ]]; then
		e_error "Missing iTerm shell integration file: $current_file"
		return 1
	fi

	temp_dir="$(mktemp -d "${TMPDIR:-/tmp}/iterm2_shell_integration.XXXXXX")" || return 1
	new_file="$temp_dir/.iterm2_shell_integration.$shell_name"

	if ! curl --fail --show-error --location --proto '=https' --tlsv1.2 \
		"https://iterm2.com/shell_integration/$shell_name" --output "$new_file"; then
		rm -rf "$temp_dir"
		return 1
	fi

	new_version="$(awk -F '[;=]' '/ShellIntegrationVersion/ { print $3; exit }' "$new_file")"
	current_version="$(awk -F '[;=]' '/ShellIntegrationVersion/ { print $3; exit }' "$current_file")"
	if [[ ! "$new_version" =~ ^[0-9]+$ || ! "$current_version" =~ ^[0-9]+$ ]]; then
		e_error "Invalid iTerm shell integration version"
		rm -rf "$temp_dir"
		return 1
	fi

	if ((new_version > current_version)); then
		e_debug "Updating iTerm shell integration from $current_version to $new_version"
		cp -f "$new_file" "$current_file" || {
			rm -rf "$temp_dir"
			return 1
		}
	else
		e_debug "iTerm shell integration is current at version $current_version"
	fi

	rm -rf "$temp_dir"
}

# Test whether we're in a git repo
#is_git_repo() {
#    $(git rev-parse --is-inside-work-tree &> /dev/null)
#}

# Test whether a command exists
# $1 - cmd to test
type_exists() {
	if [ "$(type -P "$1")" ]; then
		return 0
	fi
	return 1
}

dir_exists() {
	if [ -d "$1" ]; then
		return 0
	fi
	return 1
}

file_exists() {
	if [ -e "$1" ]; then
		return 0
	fi
	return 1
}

create_formula_list_file() {
	brew list --formula > "$SCRIPT_DIR"/forms
	return 0
}

# Test whether a Homebrew formula is already installed
# $1 - formula name (may include options)
formula_exists() {
	if $(brew list $1 >/dev/null 2>&1); then
		printf "%s already installed.\n" "$1"
		return 0
	fi

	e_warning "Missing formula: $1"
	return 1
}

formula_exists2() {

	# echo ".. $1"
	# strip off any params from --
	b=${1% --*}

	# echo ".. $b"

	if $(grep "^$b" "$SCRIPT_DIR"/forms >/dev/null 2>&1); then
		printf "%s already installed.\n" "$b"
		return 0
	fi

	e_warning "Missing formula: $1"
	return 1
}
